# ~/sure/.env on menddell (chmod 600). Never commit the real file.
# Generate each secret once with `openssl rand -hex 64` (SECRET_KEY_BASE) or
# `openssl rand -hex 32` (the rest). Never change them on a running install:
# the database's encrypted fields (Plaid access tokens, emails) need them.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Plaid production keys (same app as the plaid-personal MCP).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Leave both off. See Local/README.md, "Plaid guardrails".
PLAID_ALLOW_LINK=false
PLAID_ALLOW_TRANSACTIONS_REFRESH=false

# Image tag to run. Local/update.sh pins this to <release>-josue.
SURE_IMAGE_TAG=latest-josue

# Where Local/backup.sh mirrors ./backups (rsync target).
BACKUP_RSYNC_TARGET=user@host:backups/sure-menddell/
